<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <title>Title</title>
        <!-- Required meta tags -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Bootstrap CSS v5.3.8 -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
    </head>

    <body>
        <header>
           <h1 class="text-center">CLIENTES REGISTRADOS</h1>
           <h2 class="text-center">REGISTRAR USUARIO</h2>
        </header>
        <form action="/validar" method="post">
        <main class="my-5">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3">
                        <input type="text"
                        name="dni"
                        placeholder="Coloca tu DNI"
                        maxlength="8"
                        required
                        class="form-control"
                        >
                    </div>
                    <div class="col-lg-3">
                        <input type="text"
                        name="nombres"
                        placeholder="Coloca tus Nombres"
                        required
                        class="form-control"
                        >
                    </div>
                     <div class="col-lg-3">
                        <input type="email"
                        name="correo"
                        placeholder="Coloca tu Correo Electronico"
                        required
                        class="form-control"
                        >
                    </div>
                       <div class="col-lg-3">
                        <input type="tel"
                        name="celular"
                        placeholder="Coloca tu Celular"
                        required
                        maxlength="9"
                        class="form-control"
                        >
                    </div>
                </div>
            </div>
        </main>
        <main>
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <button type="submit" class="form-control  bg-dark text-white">AGREGAR CLIENTE</button>
                    </div>
                    <div class="col-lg-6">
                        <button type="submit" class="form-control bg-primary text-white">LIMPIAR</button>
                    </div>
                </div>
            </div>
        </main>
        </form>

        <div class="container">
        <table class="table">
    
        <thead class="table-dark">
        <tr>
            <td>DNI</td>
            <td>Nombres</td>
            <td>Correo</td>
            <td>Celular</td>
        </tr>
        </thead>
        <tbody>
        <% usuarios.forEach(function(usuario) { %>
      
        <tr>
            <td><%= usuario.dni %></td>
            <td><%= usuario.nombres %></td>
            <td><%= usuario.correo %></td>
            <td><%= usuario.celular %></td>
            <td>
                <a href="">Editar</a>
            </td>
        </tr>
        <% }); %>
        </tbody>
        </table>
        </div>
        <footer>
            <!-- place footer here -->
        </footer>
        <!-- Bootstrap JavaScript Bundle (includes Popper) -->
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        ></script>
    </body>
</html>
